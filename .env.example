# Porta do servidor
PORT=3000

# Token de autenticação Bearer
# OBRIGATÓRIO: Configure um token seguro
# Gere com: openssl rand -base64 32
# Exemplo: BEARER_TOKEN=dGVzdF90b2tlbl9wb2NfMjAyNg==
BEARER_TOKEN=seu_token_secreto_aqui

# Origens permitidas para CORS (separadas por vírgula)
# Use '*' apenas para desenvolvimento
# Em produção, especifique os domínios Salesforce
# Exemplo: ALLOWED_ORIGINS=https://example.my.salesforce.com,https://example--sandbox.sandbox.my.salesforce.com
ALLOWED_ORIGINS=*

# Ambiente
NODE_ENV=development
